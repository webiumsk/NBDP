"true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,194][1080,1794]"><node index="0" text="Public Inbox Relays" resource-id="" class="android.widget.TextView" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[26,194][344,223]" /><node index="1" text="This relay type receives all replies, comments, likes and zaps to your posts. They can be paid or free relays. Limits set by the relay operator can limit the notifications you receive for the good and for the bad. For example, if you are being attacked by comment spam, paid relays can filter the spam out. Insert between 1–3 relays." resource-id="" class="android.widget.TextView" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[26,223][1054,541]" /><node index="2" text="" resource-id="" class="android.widget.EditText" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[26,575][1054,743]"><node index="0" text="Add a Relay" resource-id="" class="android.widget.TextView" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[68,645][287,694]" /><node index="1" text="" resource-id="" class="android.view.View" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[68,607][825,733]" /><node index="2" text="" resource-id="" class="android.view.View" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[836,608][1028,734]"><node index="0" text="Add" resource-id="" class="android.widget.TextView" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[899,644][965,697]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[836,618][1028,723]" /></node></node><node index="3" text="DM Inbox Relays" resource-id="" class="android.widget.TextView" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[26,806][298,859]" /><node index="4" text="Insert between 1–3 relays to serve as your private inbox. Others will use these relays to send DMs to you. DM Inbox relays should accept any message from anyone, but only allow you to download them. Good options are:&#10; - inbox.nostr.wine (paid)&#10; - auth.nostr1.com (free)&#10; - you.nostr1.com (personal relays - paid)" resource-id="" class="android.widget.TextView" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[26,859][801,1336]" /><node index="5" text="" resource-id="" class="android.view.View" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[809,807][1054,933]"><node index="0" text="Default" resource-id="" class="android.widget.TextView" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[872,843][991,896]" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[809,817][1054,922]" /></node><node index="6" text="" resource-id="" class="android.widget.EditText" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[26,1370][1054,1538]"><node index="0" text="Add a Relay" resource-id="" class="android.widget.TextView" package="com.vitorpamplona.amethyst.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[68,1440][287,1489]" /><node index="1" text="" resource-id="" class="android.view.View" package="com.vitorpamplona.am