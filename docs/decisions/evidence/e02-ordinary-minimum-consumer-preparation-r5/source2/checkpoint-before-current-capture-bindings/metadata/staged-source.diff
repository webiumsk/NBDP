+def model_execution_record(files, descriptor):
+    """Decode unchanged legacy model metadata, decimal only at durationSeconds.
+
+    This is not the protocol/ordinary DATA decoder. Strict numeric/file bounds
+    remain unchanged. The actual legacy record is read and never rewritten.
+    """
+    import decimal
+    import json
+    def pairs(items):
+        value = {}
+        for key,item in items:
+            need(key not in value, 'DUPLICATE_MODEL_EXECUTION_KEY'); value[key] = item
+        return value
+    def number(token):
+        need(token != '-0', 'MODEL_EXECUTION_NEGATIVE_ZERO')
+        return integer(int(token), -I64, I64)
+    def fraction(token):
+        need(len(token) <= 128, 'MODEL_EXECUTION_DECIMAL_BOUND')
+        value = decimal.Decimal(token)
+        need(value.is_finite() and not (value.is_zero() and value.is_signed()), 'MODEL_EXECUTION_DECIMAL_DOMAIN')
+        return value
+    def invalid(_): need(False, 'MODEL_EXECUTION_NONFINITE')
+    value = json.loads(files.read(descriptor).decode('utf-8','strict'),object_pairs_hook=pairs,
+        parse_int=number,parse_float=fraction,parse_constant=invalid)
+    stack,count=[(value,())],0
+    while stack:
+        item,path=stack.pop();count+=1
+        need(len(path)<=48 and count<=250000,'MODEL_EXECUTION_STRUCTURE_BOUND')
+        if type(item) is decimal.Decimal: equal(path,('durationSeconds',),'DECIMAL_ONLY_MODEL_EXECUTION_DURATION')
+        elif type(item) is int:integer(item,-9007199254740991,9007199254740991)
+        elif type(item) is str:text(item,16777216)
+        elif type(item) is dict:stack.extend((v,path+(k,)) for k,v in item.items())
+        elif type(item) is list:stack.extend((v,path+(i,)) for i,v in enumerate(item))
+    closed(value,'argv exitCode reaped eof fault durationSeconds inputsBefore inputsAfter inputsUnchanged stdout stderr scope snapshotNotRaceFree')
+    duration=value['durationSeconds']
+    need(type(duration) is int or type(duration) is decimal.Decimal,'MODEL_EXECUTION_DURATION_TYPE')
+    need(0<=duration<=63,'MODEL_EXECUTION_ORIGINAL_60_PLUS_REAP_BOUND')
+    return value
+
+
