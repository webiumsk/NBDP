+evaluates them. Model phase rows below do not claim actual guard execution.
+"""
+import ast
+import hashlib
+from pathlib import Path
+import re
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import consumer
+import observer
+import strict
