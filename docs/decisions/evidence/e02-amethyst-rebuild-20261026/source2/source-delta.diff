+def platform_properties(raw):
+    """Exact stable API37.0 package grammar; never float/int coercion."""
+    require(type(raw) is bytes and 0 < len(raw) <= 65536, 'PLATFORM_PROPERTIES_BYTES')
+    properties = {}
+    text = raw.decode('utf-8', 'strict')
+    require(not any(ord(c) < 32 and c != '\n' for c in text), 'PLATFORM_PROPERTIES_CONTROL_FORMAT')
+    for line in text.splitlines():
+        require(line and line == line.strip() and '=' in line, 'PLATFORM_PROPERTY_LINE_FORMAT')
+        key, value = line.split('=', 1)
+        require(re.fullmatch('[A-Za-z][A-Za-z0-9.]*', key) and key not in properties,
+            'PLATFORM_PROPERTY_KEY_OR_DUPLICATE')
+        properties[key] = value
+    version = re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)', properties.get('AndroidVersion.ApiLevel', ''))
+    require(version is not None and version.groups() == ('37', '0'), 'EXACT_PLATFORM_MAJOR_MINOR_37_0')
+    for key, value in {'Pkg.Revision':'2', 'Platform.Version':'17',
+        'AndroidVersion.PreviewSdkInt':'0', 'AndroidVersion.ExtensionLevel':'22',
+        'AndroidVersion.IsBaseSdk':'true', 'AndroidVersion.CodeName':'',
+        'Platform.CodeName':'', 'AndroidVersion.BetaVersion':''}.items():
+        require(properties.get(key) == value, 'EXACT_STABLE_PLATFORM_FIELD:'+key)
+    return properties
+
