+def commandline_properties(raw):
+    """Strict literal22.0 metadata only; this never invokes an acquired tool."""
+    require(type(raw) is bytes and 0 < len(raw) <= 65536, 'CMDLINE_PROPERTIES_BYTES')
+    text = raw.decode('utf-8', 'strict')
+    require(not any(ord(c) < 32 and c != '\n' for c in text), 'CMDLINE_PROPERTIES_CONTROL_FORMAT')
+    values = {}
+    for line in text.splitlines():
+        if not line or line.startswith('#'): continue
+        require(line == line.strip() and '=' in line, 'CMDLINE_PROPERTY_FORMAT')
+        key, value = line.split('=', 1)
+        require(re.fullmatch('[A-Za-z][A-Za-z0-9.]*', key) and key not in values, 'CMDLINE_PROPERTY_KEY_OR_DUPLICATE')
+        values[key] = value
+    require(values.get('Pkg.Revision') == '22.0', 'EXACT_CMDLINE_REVISION_22_0')
+    require(values.get('Pkg.Desc') == 'Android SDK Command-line Tools', 'EXACT_CMDLINE_DESCRIPTION')
+    require('Pkg.Path' not in values or values['Pkg.Path'] == 'cmdline-tools;22.0', 'EXACT_CMDLINE_PATH_IF_PRESENT')
+    return values
