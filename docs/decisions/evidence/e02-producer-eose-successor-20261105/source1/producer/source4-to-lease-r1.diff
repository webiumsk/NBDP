+  fstatSync(fd){assert.equal(fd,23);return {isFile:()=>true,size:raw.length};},
+  readFileSync(fd){assert.equal(fd,23);io.read++;return Buffer.from(raw);},
+  closeSync(fd){assert.equal(fd,23);io.closed++;}};
+ const parser=text=>{const value=strictGuardJSON(text);parsed.push(value);return value;};
